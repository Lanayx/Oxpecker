<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
        <WarningsAsErrors>3239;0025;3261</WarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Nullable>enable</Nullable>
        <PackageId>Oxpecker.Htmx</PackageId>
        <Title>Oxpecker.Htmx</Title>
        <RootNamespace>Oxpecker.Htmx</RootNamespace>
        <AssemblyName>Oxpecker.Htmx</AssemblyName>
        <Company>F# community</Company>
        <Description>HTMX 4 support for Oxpecker.ViewEngine</Description>
        <RepositoryUrl>https://github.com/Lanayx/Oxpecker</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Lanayx/Oxpecker/tree/develop/src/Oxpecker.Htmx</PackageProjectUrl>
        <PackageIcon>oxpecker-128.png</PackageIcon>
        <RepositoryType>git</RepositoryType>
        <PackageTags>Oxpecker;ViewEngine;F#;FSharp;DSL;Html;Web;HTMX;HTMX4</PackageTags>
        <Authors>Vladimir Shchur and contributors</Authors>
        <Copyright>Copyright (c) Vladimir Shchur 2024</Copyright>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Version>4.0.0</Version>
        <PackageVersion>4.0.0</PackageVersion>
        <PackageReleaseNotes>Aligned with htmx 4.0.0: added hxQuery, hxMorphSkip, hxMorphSkipChildren, HxSwapModifier.swapEmpty, hxPrompt, hxPending, hxMultipartConnect/hxMultipartClose, hxLiveBind (with HxLiveBinding) and the HX-Prompt/HX-Last-Part-ID/HX-Part-ID headers. HxSwapModifier.settle/settleMs now emit a leading space like the other swap modifiers. Breaking: removed hxOptimistic and the HX-Request-ID headers, which no longer exist in htmx.</PackageReleaseNotes>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\images\oxpecker-128.png" Pack="true" PackagePath="\" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <Compile Include="Helpers.fs" />
        <Compile Include="Attributes.fs" />
        <Compile Include="Extensions.fs" />
        <Compile Include="Headers.fs" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Oxpecker.ViewEngine\Oxpecker.ViewEngine.fsproj" />
    </ItemGroup>
</Project>
