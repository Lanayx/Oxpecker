
import { createSignal } from "solid-js";

export function Component(getText) {
    return <h1 onClick={(_arg) => {
            console.log(getText());
        }}>
        {getText()}
    </h1>;
}

export function Test() {
    const patternInput = createSignal("Hello");
    return <div>
        {Component(patternInput[0])}
    </div>;
}

