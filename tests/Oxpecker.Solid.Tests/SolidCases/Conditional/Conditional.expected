
import { createSignal } from "solid-js";

export function LetBoundFallback() {
    const patternInput = createSignal([]);
    const emptyMsg = <div class="empty">
        Nothing yet
    </div>;
    return <div class="wrapper">
        <Show when={patternInput[0]().length > 0}
            fallback={emptyMsg}>
            <div class="list">
                items go here
            </div>
        </Show>
        <form novalidate={true}>
            <input type="text"
                name="host" />
            <button type="submit">
                Add
            </button>
        </form>
    </div>;
}

export function Test(show) {
    const x = createSignal(7)[0];
    return <ErrorBoundary fallback={(err, _arg) => <div>
            {`An error occurred ${err}`}
        </div>}>
        <Show when={show}
            fallback={<div>
                World
            </div>}>
            <div>
                Hello
            </div>
        </Show>
        <Switch fallback={<p>
                {x()}
                is between 5 and 10
            </p>}>
            <Match when={x() > 10}>
                <p>
                    {x()}
                    is greater than 10
                </p>
            </Match>
            <Match when={x() < 5}>
                <p>
                    {x()}
                    is less than 5
                </p>
            </Match>
        </Switch>
    </ErrorBoundary>;
}

