
import { Route, Router, useMatch, usePreloadRoute, useNavigate, A } from "@solidjs/router";
import { lazy, createEffect } from "solid-js";
import { App1 } from "./App1.jsx";
import { App2 } from "./App2.jsx";

export function Root(props) {
    return <>
        <h1>
            Root header
        </h1>
        {props.children}
        <A href="/about">
            About
        </A>
    </>;
}

export function App3() {
    const navigator = useNavigate();
    const preload = usePreloadRoute();
    createEffect(() => {
        preload("/def/inner");
        preload("/def/inner", ({
            preloadData: true,
        }));
        preload("/def/inner", ({
            preloadData: false,
        }));
        navigator("/def/inner");
    });
    return <h1>
        Hello world 3
    </h1>;
}

export function MatchInfo() {
    const matched = useMatch(() => "/users/:id");
    return () => {
        let value;
        const option_1 = matched();
        return (option_1 != null) ? ((value = option_1, [value.path, value.params])) : undefined;
    };
}

export function Test1() {
    return <Router root={Root}>
        <Route />
        <Route path="/def">
            <Route path="/inner"
                component={App1} />
        </Route>
        <Route path="/ghi"
            component={App2} />
    </Router>;
}

export function Test2() {
    const routes = [{
        path: "/app1",
        component: lazy(() => (import("/App1"))),
    }, {
        path: "/app2",
        component: lazy(() => (import("/App2"))),
    }];
    return <Router>
        {routes}
    </Router>;
}

